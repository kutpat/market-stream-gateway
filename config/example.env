# Listener and process behavior
MSG_BIND=127.0.0.1:8080
MSG_LOG_FORMAT=json
MSG_DOWNSTREAM_BUFFER=4096
MSG_MAX_DOWNSTREAM_CLIENTS=64
MSG_MAX_CLIENT_SUBSCRIPTIONS=512
# Unset by default: each provider uses its own declared ceiling, advertised in the hello frame as
# provider_subscription_limits. Setting this only tightens those ceilings; it cannot raise one past
# what a provider declared, because that declaration may be a venue rule.
# MSG_MAX_PROVIDER_SUBSCRIPTIONS=200
MSG_MAX_COMMAND_BYTES=65536
MSG_MAX_HISTORY_REQUESTS=8
# Browser WebSocket origins are denied by default. Use an exact comma-separated allowlist only
# when a browser client is intentionally deployed.
# MSG_ALLOWED_ORIGINS=https://internal.example.com
MSG_UPSTREAM_BACKOFF_MIN_MS=500
MSG_UPSTREAM_BACKOFF_MAX_MS=30000
MSG_STABLE_CONNECTION_SECONDS=60
MSG_SHUTDOWN_GRACE_SECONDS=10
MSG_CATALOG_REFRESH_SECONDS=21600

# Provider endpoints (public data only; no credentials are required)
MSG_BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
MSG_BINANCE_WS_URL=wss://fstream.binance.com/market/ws
MSG_OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
MSG_OKX_BUSINESS_WS_URL=wss://ws.okx.com:8443/ws/v5/business
MSG_MEXC_WS_URL=wss://contract.mexc.com/edge
MSG_BINGX_WS_URL=wss://open-api-swap.bingx.com/swap-market
MSG_BYBIT_REST_URL=https://api.bybit.com/
MSG_BINANCE_FUTURES_REST_URL=https://fapi.binance.com/
MSG_OKX_REST_URL=https://www.okx.com/
MSG_KUCOIN_FUTURES_REST_URL=https://api-futures.kucoin.com/
MSG_MEXC_FUTURES_REST_URL=https://api.mexc.com/
MSG_BINGX_SWAP_REST_URL=https://open-api.bingx.com/

# Comma-separated bybit,binance,okx,kucoin,mexc,bingx; use all or none as a single value.
MSG_PROVIDERS=all
